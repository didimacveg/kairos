  "always_listening": true,
  "_como_conseguir_las_canciones": [
    "Los URI 'spotify:track:...' de abajo son PLACEHOLDERS y no funcionaran.",
    "Para cada cancion: abrela en Spotify, clic derecho sobre ella,",
    "Compartir > Copiar enlace de la cancion, y pega aqui la parte del ID.",
    "Un enlace https://open.spotify.com/track/ABC123?si=xx  se convierte en",
    "spotify:track:ABC123   (todo lo que va despues de ? se descarta).",
    "Sin el URI real, Spotify se abre pero no reproduce nada."
  ],
  "_notas": [
    "monitor 0 = el de mas a la izquierda, 1 = el siguiente.",
    "slot: full | left | right | top-left | top-right | bottom-left | bottom-right",
    "'window' es un trozo del titulo de la ventana; sirve para encontrarla,",
    "recolocarla y —al cerrar el perfil— saber cual cerrar."
  ],
