# ---------------------------------------------------------------------------
# KAIROS OS — configuracion de entorno
# Copia este fichero a `.env` y rellena los valores. `.env` NUNCA va a git.
# ---------------------------------------------------------------------------

# --- Identidad de la instancia ---------------------------------------------
KAIROS_INSTANCE_NAME=kairos-home
KAIROS_ENV=development           # development | production

# --- Red --------------------------------------------------------------------
# Por defecto el core solo escucha en loopback. Para exponerlo a la LAN
# cambia a 0.0.0.0 y lee docs/threat-model.md antes de hacerlo.
KAIROS_BIND_HOST=127.0.0.1
KAIROS_BIND_PORT=8000
KAIROS_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=kairos
POSTGRES_PASSWORD=cambia-esto-por-algo-largo-y-aleatorio
POSTGRES_DB=kairos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Sesiones ---------------------------------------------------------------
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
KAIROS_SESSION_SECRET=cambia-esto-por-un-secreto-de-48-bytes
KAIROS_SESSION_TTL_HOURS=72
# `true` solo si sirves por HTTPS. En LAN sin TLS debe ser false o la cookie
# no se enviara nunca y el login parecera roto sin motivo aparente.
KAIROS_COOKIE_SECURE=false

# --- LLM local (por defecto) ------------------------------------------------
KAIROS_OLLAMA_URL=http://ollama:11434
KAIROS_CHAT_MODEL=llama3.1:8b
KAIROS_EMBEDDING_MODEL=nomic-embed-text
KAIROS_EMBEDDING_DIM=768
KAIROS_LLM_TIMEOUT_SECONDS=120

# --- Salida a Internet ------------------------------------------------------
# Interruptor maestro. En `false` el core rechaza cualquier llamada saliente
# a proveedores cloud, aunque haya claves configuradas. Es la garantia de la
# regla fundacional: KAIROS funciona sin Internet.
KAIROS_ALLOW_EGRESS=false
# Solo se leen si KAIROS_ALLOW_EGRESS=true.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Memoria ----------------------------------------------------------------
KAIROS_MEMORY_TOP_K=6
KAIROS_MEMORY_MIN_SIMILARITY=0.35
